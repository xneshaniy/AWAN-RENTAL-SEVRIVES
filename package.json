{
  "name": "awan-rental-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --no-lint",
    "postbuild": "node scripts/copy-standalone.mjs",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "npm run test:whatsapp && npm run test:google-reviews && npm run test:availability && npm run test:cloudinary && npm run test:availability:db && npm run test:notifications && npm run test:email && npm run test:gallery && npm run test:robots && npm run test:safepay",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "test:whatsapp": "node --env-file-if-exists=.env --import tsx tests/whatsapp.test.ts",
    "test:notifications": "node --env-file-if-exists=.env --import tsx tests/notifications.test.ts",
    "test:email": "node --env-file-if-exists=.env --import tsx tests/email-confirmed.test.ts",
    "test:gallery": "node --env-file-if-exists=.env --import tsx tests/gallery.test.ts",
    "test:robots": "node --env-file-if-exists=.env --import tsx tests/robots.test.ts",
    "test:safepay": "node --env-file-if-exists=.env --import tsx tests/safepay.test.ts",
    "test:e2e": "playwright test tests/e2e/a11y.spec.ts --output=test-results/a11y && playwright test tests/e2e/notifications.spec.ts --output=test-results/notifications && playwright test tests/e2e/responsive.spec.ts --output=test-results/responsive && playwright test tests/e2e/gallery.spec.ts --output=test-results/gallery && playwright test tests/e2e/home.spec.ts --output=test-results/home",
    "test:google-reviews": "node --env-file-if-exists=.env --import tsx tests/google-reviews.test.ts",
    "test:availability": "node --env-file-if-exists=.env --import tsx tests/availability.test.ts",
    "test:cloudinary": "node --env-file-if-exists=.env --import tsx tests/cloudinary.test.ts",
    "test:availability:db": "node --env-file-if-exists=.env --import tsx tests/availability.db.test.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.0",
    "@prisma/client": "^5.17.0",
    "@tanstack/react-query": "5.51.1",
    "axios": "1.20.0",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "csstype": "^3.1.3",
    "date-fns": "3.6.0",
    "date-fns-tz": "3.1.3",
    "framer-motion": "^10.16.4",
    "language-subtag-registry": "^0.4.2",
    "lucide-react": "^0.395.0",
    "next": "14.2.35",
    "next-auth": "^4.24.15",
    "next-themes": "0.3.0",
    "nodemailer": "6.9.14",
    "oauth": "^0.9.15",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.52.1",
    "react-hot-toast": "2.4.1",
    "react-intersection-observer": "^11.0.1",
    "sharp": "0.33.4",
    "swiper": "11.1.5",
    "tailwind-merge": "^2.4.0",
    "tsconfig-paths": "^4.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.14.10",
    "@types/nodemailer": "6.4.15",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "8.5.23",
    "prisma": "^5.17.0",
    "tailwindcss": "3.4.4",
    "tsx": "4.16.2",
    "typescript": "5.5.3"
  }
}
