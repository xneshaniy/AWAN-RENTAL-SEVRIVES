# =========================================================
# Awan Rental Service — example environment file
# Copy to .env and fill in real values. Never commit .env.
# Production site: https://awanrentalservice.org/
# =========================================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/awan_rental?schema=public"

# Site URL (used for canonical URLs, sitemap.xml, robots.txt, Open Graph)
NEXT_PUBLIC_SITE_URL="https://awanrentalservice.org"

# NextAuth
# Local development: NEXTAUTH_URL="http://localhost:3000"
# Production:       NEXTAUTH_URL="https://awanrentalservice.org"
NEXTAUTH_SECRET="***REMOVED***"
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp business number (wa.me links are built from digits only)
NEXT_PUBLIC_WHATSAPP_NUMBER="+923056846811"

# Admin notification / administrator account email
ADMIN_EMAIL="info@awanrentalservice.org"

# Email (SMTP) - Optional for development
# Hostinger business mailbox, SSL on port 465.
# Gmail alternative: SMTP_HOST="smtp.gmail.com", SMTP_PORT="587".
# IMAP (imap.hostinger.com) is only needed to *read* mail - the site never does.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="info@awanrentalservice.org"
SMTP_PASSWORD="your-mailbox-password"

# Optional: Stripe for payments
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional: Image storage (Cloudinary, AWS S3, etc.)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: Analytics / Search Console
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Optional: live Google reviews on the homepage (server-only, never NEXT_PUBLIC_*)
# Leave GOOGLE_PLACES_API_KEY blank and the homepage shows a "See our reviews
# on Google" link instead - no rating is ever displayed unless Google returned it.
#   API key  : Google Cloud console -> APIs & Services -> Credentials
#              (enable "Places API (New)" and attach a billing account)
#   Place ID : already filled in for this business listing
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID="ChIJ9zcES-QJGTkRAzHlfjTCaG8"
