# =========================================================
# Awan Rental Service — example environment file
# Copy to .env and fill in real values. Never commit .env.
# Production site: https://awanrentalservice.org/
# =========================================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/awan_rental?schema=public"

# Site URL (used for canonical URLs, sitemap.xml, robots.txt, Open Graph)
NEXT_PUBLIC_SITE_URL="https://awanrentalservice.org"

# NextAuth
# Local development: NEXTAUTH_URL="http://localhost:3000"
# Production:       NEXTAUTH_URL="https://awanrentalservice.org"
NEXTAUTH_SECRET=<run: openssl rand -base64 32>
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp business number (wa.me links are built from digits only)
NEXT_PUBLIC_WHATSAPP_NUMBER="+923056846811"

# Admin notification / administrator account email
ADMIN_EMAIL="info@awanrentalservice.org"
# Seeded admin account password (required by prisma/seed.ts, minimum 8 chars)
ADMIN_PASSWORD="<set-a-strong-password>"

# Email (SMTP) - Optional for development
# Hostinger business mailbox, SSL on port 465.
# Gmail alternative: SMTP_HOST="smtp.gmail.com", SMTP_PORT="587".
# IMAP (imap.hostinger.com) is only needed to *read* mail - the site never does.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER=<your-smtp-user>
SMTP_PASSWORD="your-mailbox-password"

# Optional: Stripe for payments (reserved - no Stripe code exists)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------
# Optional: SafePay hosted checkout - online booking deposit (IMPLEMENTED)
#
# All three credentials come from the SafePay dashboard. The deposit offer is
# hidden until ALL THREE are set, so configuring one or two can never move
# money: without the webhook secret there is no way to verify an event, so we
# refuse to take a payment we could not confirm.
#
#   Public API key      : Developers > API         (starts with sec_)
#   Private API secret  : Developers > API         (second item, copy icon)
#   Webhook shared secret: Developers > Endpoints  > "View shared secret"
#
#   Sandbox dashboard: https://sandbox.api.getsafepay.com/dashboard
#   Live dashboard   : https://getsafepay.com/dashboard/login
# Sandbox and live secrets are DIFFERENT keys - never reuse one for the other.
#
# Register this endpoint (sandbox and live separately, each with its own
# secret), and subscribe to the 2.0.0 payment events:
#   https://awanrentalservice.org/api/payments/safepay/webhook
#
# SAFEPAY_WEBHOOK_SECRET accepts a comma-separated list so a key can be rotated
# without dropping events that SafePay already queued for signing with the old
# key. SAFEPAY_ENV defaults to "sandbox"; only the exact value "production"
# takes it live, so a typo can never start charging real cards.
SAFEPAY_ENV="sandbox"
SAFEPAY_API_KEY=""
SAFEPAY_API_SECRET=""
SAFEPAY_WEBHOOK_SECRET=""

# Optional: Image storage (Cloudinary, AWS S3, etc.)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: Analytics / Search Console
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Optional: live Google reviews on the homepage (server-only, never NEXT_PUBLIC_*)
# Leave GOOGLE_PLACES_API_KEY blank and the homepage shows a "See our reviews
# on Google" link instead - no rating is ever displayed unless Google returned it.
#   API key  : Google Cloud console -> APIs & Services -> Credentials
#              (enable "Places API (New)" and attach a billing account)
#   Place ID : already filled in for this business listing
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID="ChIJ9zcES-QJGTkRAzHlfjTCaG8"
