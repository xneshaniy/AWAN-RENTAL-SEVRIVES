{
  "name": "Awan Rental Admin",
  "short_name": "ARS Admin",
  "description": "Admin dashboard for Awan Rental Service - manage bookings, vehicles, customers, and settings.",
  "start_url": "/admin",
  "scope": "/admin/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f7f6f2",
  "theme_color": "#15803d",
  "icons": [
    {
      "src": "/admin-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/admin-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/admin-icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": ["business", "productivity"],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "View admin dashboard",
      "url": "/admin",
      "icons": [{ "src": "/admin-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Bookings",
      "short_name": "Bookings",
      "description": "Manage bookings",
      "url": "/admin/bookings",
      "icons": [{ "src": "/admin-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Vehicles",
      "short_name": "Vehicles",
      "description": "Manage vehicles",
      "url": "/admin/vehicles",
      "icons": [{ "src": "/admin-icon-192.png", "sizes": "192x192" }]
    }
  ]
}