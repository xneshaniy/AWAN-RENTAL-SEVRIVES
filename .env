# Build-time resource limits for Hostinger deployment
SWEC_WORKER_THREADS=1
NEXT_SWEC_WORKER_THREADS=1
NODE_OPTIONS=--max-old-space-size=512

# Database URL (set in Hostinger control panel - do not commit real values)
DATABASE_URL=""

# Site URL
NEXT_PUBLIC_SITE_URL="https://awanrentalservice.org"

# NextAuth
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://awanrentalservice.org"

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER="+923056846811"

# Admin
ADMIN_EMAIL="info@awanrentalservice.org"

# SafePay (sandbox defaults)
SAFEPAY_ENV="sandbox"

# Optional integrations
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""